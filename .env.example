# ===== 数据存储 =====
# SQLite 数据库文件与原型文件位于同一数据目录，随数据卷持久化。
DATA_DIR=/data
DATABASE_FILE=/data/axhub.sqlite3

# ===== 访问地址 =====
# 对外访问地址，运行期读取，用于生成分享与查看链接。
# 部署时填写内网实际地址（如 http://192.168.1.100:3000）。
# 本地开发若端口与 npm run dev（next dev 默认 3000）不同，请在 .env.local 中覆盖本项。
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# 应用基础路径，构建期内联，需用 docker build --build-arg 指定，运行期修改无效。
# 保留 /manage 便于内网反向代理挂载子路径。
NEXT_PUBLIC_BASE_PATH=/manage

# 宿主机映射端口（仅容器部署使用）
APP_HOST_PORT=3000
# 是否强制为会话 Cookie 设置 Secure 标志（仅通过 HTTPS 发送）。
# 内网 HTTP 访问必须设为 false，否则浏览器不会保存会话 Cookie，导致登录后无法跳转。
COOKIE_SECURE=false

# ===== 安全密钥（生产部署必须替换为独立随机值）=====
# 至少 32 个随机字符，用于签发登录会话。生成方式：openssl rand -base64 32
SESSION_SIGNING_SECRET=change-me-to-a-random-32-char-secret-0001
# 至少 32 个随机字符，用于加密分享密码；必须与上面的会话密钥不同。
SHARE_PASSWORD_ENCRYPTION_KEY=change-me-to-a-random-32-char-key-000002

# ===== 原型截图 =====
# Chromium/Chrome 可执行文件路径（容器内为 /usr/bin/chromium）。
CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium

# 上传时为系统与数据库预留的磁盘比例，避免磁盘写满。
STORAGE_RESERVE_RATIO=0.2

# ===== 首位超级管理员（首次启动时初始化，已有用户则跳过）=====
BOOTSTRAP_SUPER_ADMIN_ACCOUNT=admin
BOOTSTRAP_SUPER_ADMIN_PASSWORD=change-me-8plus
BOOTSTRAP_SUPER_ADMIN_NAME=系统管理员
BOOTSTRAP_DEPARTMENT_NAME=产品中心
