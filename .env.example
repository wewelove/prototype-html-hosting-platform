# SQLite 数据库文件（与原型文件同目录，位于持久化数据卷内）
DATABASE_FILE=/data/axhub.sqlite3
DATA_DIR=/data

# 应用基础路径（构建时和运行时必须一致）
NEXT_PUBLIC_BASE_PATH=/manage
APP_HOST_PORT=3000

# 至少 32 个随机字符，用于签发登录会话, openssl rand -base64 32
SESSION_SIGNING_SECRET=0m5hoMNYiAxVluBT/RHrM9ynBa2qyuwCI8OBPjgSEdQ=
# 至少 32 个随机字符，用于加密可回填的分享密码；请勿与会话密钥相同
SHARE_PASSWORD_ENCRYPTION_KEY=j6Er0FQLAhx+eGEZSenL4+9urxx/yKU70PBFBCxKyIc=

CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium

# 原型上传保留 20% 磁盘空间给系统与 SQLite 数据库
STORAGE_RESERVE_RATIO=0.2

# 首位超级管理员初始化
BOOTSTRAP_SUPER_ADMIN_ACCOUNT=admin
BOOTSTRAP_SUPER_ADMIN_PASSWORD=qwer1234
BOOTSTRAP_SUPER_ADMIN_NAME=系统管理员
BOOTSTRAP_DEPARTMENT_NAME=产品中心

# 本地未配置 DATABASE_FILE 时自动进入演示模式；生产环境不会启用演示模式
DEMO_MODE=false
